+class ButtonAndDataPermissionSeparationTest(TestCase):
+    """
+    测试按钮权限和数据权限的分离性
+    确保两者不会互相错位
+    """
+
+    @classmethod
+    def setUpTestData(cls):
+        """初始化测试数据"""
+        cls.dept = Dept.objects.create(name='测试部门', sort=1)
+
+        cls.menu = Menu.objects.create(
