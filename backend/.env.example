# 后端环境变量模板
# 复制为 .env 文件使用（Docker Compose 会自动读取）

# ================================================= #
# ****************** 环境选择 ******************** #
# ================================================= #
# 可选值: dev / test / prod
DJANGO_ENV=prod

# ================================================= #
# *************** 数据库配置 ******************** #
# ================================================= #
DATABASE_NAME=django-vue3-admin
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_secure_password_here

# 表前缀
TABLE_PREFIX=dvadmin_

# ================================================= #
# *************** Redis 配置 ******************** #
# ================================================= #
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=1
CELERY_BROKER_DB=3

# ================================================= #
# *************** 功能开关 ******************** #
# ================================================= #
# 调试模式（生产环境必须为 False）
DEBUG=False
# 登录详情日志
ENABLE_LOGIN_ANALYSIS_LOG=False
# 登录是否需要验证码
LOGIN_NO_CAPTCHA_AUTH=False

# ================================================= #
# *************** 其他配置 ******************** #
# ================================================= #
ALLOWED_HOSTS=*
