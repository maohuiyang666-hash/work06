APP_ENV=local_prod
APP_DEBUG=false

# 线上环境接口地址
APP_API_URL=/
APP_WS_URL=/ws

# 是否启用按钮权限
VITE_PM_ENABLED=true
VITE_PUBLIC_PATH=/web/
# dist目录
VITE_DIST_PATH=../backend/templates/web/

# Backend
APP_DB_ENGINE=django.db.backends.mysql
APP_DB_NAME=django-vue3-admin
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_USER=root
APP_DB_PASSWORD=DVADMIN3
APP_TABLE_PREFIX=dvadmin_

APP_REDIS_URL=redis://:DVADMIN3@127.0.0.1:6379/1
APP_CELERY_BROKER_URL=redis://:DVADMIN3@127.0.0.1:6379/3

APP_CAPTCHA_ENABLED=true
APP_ALLOWED_HOSTS=*
APP_CORS_ALLOW_ALL=false
APP_STATIC_URL=/static/
APP_MEDIA_URL=/media/
