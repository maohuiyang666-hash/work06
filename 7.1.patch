+    Users, Role, Dept, Menu, MenuButton,
+    RoleMenuButtonPermission, RoleMenuPermission
+)
+from dvadmin.utils.filters import DataLevelPermissionsFilter, get_dept
+from dvadmin.system.views.menu_button import MenuButtonViewSet
+from dvadmin.system.views.user import UserViewSet
+
+
+class PermissionTestBase(TestCase):
+    """
+    权限测试基类
+    提供公共的测试数据设置
