+        cls.dept_group = Dept.objects.create(
+            name="集团公司",
+            key="group",
+            sort=1,
+            status=True
+        )
+        cls.dept_tech = Dept.objects.create(
+            name="技术部",
+            key="tech",
+            sort=2,
+            status=True,
+            parent=cls.dept_group
+        )
+        cls.dept_dev = Dept.objects.create(
+            name="开发组",
+            key="dev",
+            sort=3,
+            status=True,
+            parent=cls.dept_tech
+        )
+        cls.dept_market = Dept.objects.create(
+            name="市场部",
+            key="market",
+            sort=4,
+            status=True,
+            parent=cls.dept_group
+        )
+
+        # 创建菜单
+        cls.menu_user = Menu.objects.create(
+            name="用户管理",
+            web_path="/system/user",
+            component_name="User",
+            sort=1,
+            status=True
+        )
+
+        # 创建菜单按钮
+        cls.btn_list = MenuButton.objects.create(
+            name="查询",
+            value="User:List",
+            api="/api/system/user/",
+            method=0,  # GET
+            menu=cls.menu_user
+        )
+        cls.btn_create = MenuButton.objects.create(
+            name="新增",
+            value="User:Create",
+            api="/api/system/user/",
+            method=1,  # POST
+            menu=cls.menu_user
+        )
+        cls.btn_update = MenuButton.objects.create(
+            name="修改",
+            value="User:Update",
+            api="/api/system/user/{id}/",
+            method=2,  # PUT
+            menu=cls.menu_user
+        )
+        cls.btn_delete = MenuButton.objects.create(
+            name="删除",
+            value="User:Delete",
+            api="/api/system/user/{id}/",
+            method=3,  # DELETE
+            menu=cls.menu_user
+        )
+
+        # 创建角色 - 超级管理员
+        cls.role_admin = Role.objects.create(
+            name="超级管理员",
+            key="admin",
+            sort=1,
+            status=True
+        )
+
+        # 创建角色 - 普通用户（仅本人数据）
+        cls.role_user_self = Role.objects.create(
+            name="普通用户-仅本人",
+            key="user_self",
+            sort=2,
+            status=True
+        )
+        # 分配菜单按钮权限，数据范围为仅本人（0）
+        cls.rmbp_self_list = RoleMenuButtonPermission.objects.create(
+            role=cls.role_user_self,
+            menu_button=cls.btn_list,
+            data_range=0
+        )
+        cls.rmbp_self_create = RoleMenuButtonPermission.objects.create(
+            role=cls.role_user_self,
+            menu_button=cls.btn_create,
+            data_range=0
+        )
+
+        # 创建角色 - 部门用户（本部门数据）
+        cls.role_user_dept = Role.objects.create(
+            name="普通用户-本部门",
+            key="user_dept",
+            sort=3,
+            status=True
+        )
+        RoleMenuButtonPermission.objects.create(
+            role=cls.role_user_dept,
+            menu_button=cls.btn_list,
+            data_range=2  # 本部门
+        )
+
+        # 创建角色 - 部门及下级用户（本部门及以下）
+        cls.role_user_dept_all = Role.objects.create(
+            name="普通用户-本部门及以下",
+            key="user_dept_all",
+            sort=4,
+            status=True
+        )
+        RoleMenuButtonPermission.objects.create(
+            role=cls.role_user_dept_all,
+            menu_button=cls.btn_list,
+            data_range=1  # 本部门及以下
+        )
+
+        # 创建超级管理员用户
+        cls.user_admin = Users.objects.create(
+            username="admin",
+            name="管理员",
+            is_superuser=True,
+            is_active=True,
