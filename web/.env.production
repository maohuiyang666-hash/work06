# ================================================= #
# ******************* 生产环境配置 ****************** #
# ================================================= #
# 环境标识（与后端 DJANGO_ENV 保持一致）
VITE_ENV = 'production'

# 线上环境接口地址（docker-compose部署时 nginx 自动代理此地址）
VITE_API_URL = '/api'

# WebSocket 地址
VITE_WS_URL = ''

# public path 配置
VITE_PUBLIC_PATH = /

# 是否启用按钮权限
VITE_PM_ENABLED = true

# 应用标题后缀（生产环境为空）
VITE_APP_TITLE = ''
