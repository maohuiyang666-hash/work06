# 默认环境（开发环境）
ENV = 'development'
VITE_PORT = 8080
VITE_API_URL = 'http://127.0.0.1:8000'
VITE_WS_URL = 'ws://127.0.0.1:8000'

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN = false

# public path 配置线上环境路径（打包）、本地通过 http-server 访问时，请置空即可
VITE_PUBLIC_PATH = /

# 是否启用按钮权限
VITE_PM_ENABLED = true

# 构建输出目录
VITE_DIST_PATH = dist
