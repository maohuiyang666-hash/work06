# ================================================= #
# ******************* 默认公共配置 ****************** #
# ================================================= #
# 注意：各环境的专属配置请修改对应的 .env.{env} 文件，此文件仅作为兜底默认值。
# 开发、测试、生产环境的实际值在以下文件中定义：
#   .env.development (dev)  / .env.test (test)  / .env.production (prod)

# 环境标识（与后端 DJANGO_ENV 保持一致）
VITE_ENV = 'development'

# 开发服务器端口
VITE_PORT = 8080

# API 接口地址
VITE_API_URL = 'http://127.0.0.1:8000'

# WebSocket 地址
VITE_WS_URL = ''

# 运行 npm run dev 时自动打开浏览器
VITE_OPEN = false

# public path 配置（打包）、本地通过 http-server 访问时，请置空即可
VITE_PUBLIC_PATH = /

# 是否启用按钮权限
VITE_PM_ENABLED = true

# 应用标题后缀
VITE_APP_TITLE = ''
