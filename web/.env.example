# 前端基础环境变量模板
# 复制为 .env.development / .env.test / .env.production 使用

# 环境标识
ENV = 'development'

# 服务端口
VITE_PORT = 8080

# API 基础地址
VITE_API_URL = 'http://127.0.0.1:8000'

# WebSocket 地址
VITE_WS_URL = 'ws://127.0.0.1:8000/ws'

# 开发时自动打开浏览器
VITE_OPEN = false

# 静态资源 public path（生产环境按需配置）
VITE_PUBLIC_PATH = /

# 构建输出目录（可选，默认 dist）
# VITE_DIST_PATH = dist

# 是否启用按钮权限
VITE_PM_ENABLED = true

# 构建环境标识（打包后可通过 import.meta.env.VITE_APP_ENV 查看）
VITE_APP_ENV = 'dev'
