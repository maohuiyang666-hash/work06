# ================================================= #
# *********** 本地模拟生产环境（local_prod）********** #
# ================================================= #
# 环境标识（与后端 DJANGO_ENV 保持一致）
VITE_ENV = 'local_prod'

# 接口地址
VITE_API_URL = '/'

# WebSocket 地址
VITE_WS_URL = ''

# 是否启用按钮权限
VITE_PM_ENABLED = true

# public path
VITE_PUBLIC_PATH = /web/

# dist 输出目录（后端模板目录）
VITE_DIST_PATH = ../backend/templates/web/

# 应用标题后缀
VITE_APP_TITLE = ''