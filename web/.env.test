# ================================================= #
# ******************* 测试环境配置 ****************** #
# ================================================= #
# 环境标识（与后端 DJANGO_ENV 保持一致）
VITE_ENV = 'test'

# 测试环境接口地址
VITE_API_URL = 'http://test-api.example.com'

# WebSocket 地址（为空则自动根据 VITE_API_URL 推导）
VITE_WS_URL = ''

# 运行 npm run dev 时自动打开浏览器
VITE_OPEN = false

# public path 配置（测试环境部署路径）
VITE_PUBLIC_PATH = /

# dist 输出目录
VITE_DIST_PATH = dist

# 是否启用按钮权限
VITE_PM_ENABLED = true

# 应用标题后缀（打包后用于区分环境）
VITE_APP_TITLE = '【测试环境】'